{
  "expo": {
    "name": "DigFinder",
    "slug": "DigFinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.paleo",
      "config": {
        "googleMapsApiKey": "${GOOGLE_MAPS_API_KEY}"
      }
    },
    "android": {
      "package": "com.anonymous.paleo",
      "config": {
        "googleMaps": {
          "apiKey": "${GOOGLE_MAPS_API_KEY}"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-ios-brown-window.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-background.png",
          "resizeMode": "contain",
          "backgroundColor": "#5A3725",
          "dark": {
            "image": "./assets/images/splash-background.png",
            "resizeMode": "contain",
            "backgroundColor": "#5A3725"
          }
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
